# Optional overrides for the local Docker stack. Copy to infra/.env (git-ignored) and edit.
# Every value has a working default in compose.yaml, so `make up` works without this file.
# Passwords go into URLs: use letters, digits, '-' and '_' only.
POSTGRES_PASSWORD=vectapilot-dev
# The API's role, vectapilot_app (ADR 0009). Changing it and running `make up` again rotates it.
VECTAPILOT_APP_DB_PASSWORD=vectapilot-app-dev
VECTAPILOT_LOG_LEVEL=INFO
