# For running the API or tests directly on your Mac (outside Docker) against the `make up` stack.
# Copy to apps/api/.env (git-ignored). Settings reads it automatically.
VECTAPILOT_ENVIRONMENT=local
VECTAPILOT_DATABASE_URL=postgresql+asyncpg://vectapilot:vectapilot-dev@127.0.0.1:5432/vectapilot
VECTAPILOT_REDIS_URL=redis://127.0.0.1:6379/0
VECTAPILOT_LOG_LEVEL=INFO
# LLM gateway (ADR 0006): the fake provider makes no paid call. The API key NEVER goes in this
# file: startup refuses VECTAPILOT_ANTHROPIC_API_KEY found in a .env (ADR 0007, Key handling).
VECTAPILOT_LLM_PROVIDER=fake
